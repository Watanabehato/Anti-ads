<?xml version="1.0" encoding="utf-8"?>
<!--
  :probe 独立诊断 APK Manifest（骨架基线）：不申请 INTERNET，不作为框架模块，不依赖 :app。
  由 t10 追加：AdFixtureActivity（Intent extra "scenario"）与 Provider authority 查询。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/probe_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiAdsProbe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/probe_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
