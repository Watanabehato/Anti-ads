<?xml version="1.0" encoding="utf-8"?>
<!--
  :app 宿主 Manifest（管理端；t11 集成后的最终合并对象）。
  约束（docs/contracts.md 第 1 节）：
  - 不申请 INTERNET、不申请 QUERY_ALL_PACKAGES；
  - 无 debug applicationIdSuffix，Provider authority 稳定为 com.antiads.app.config；
  - Provider 由 t8 追加（exported=true、grantUriPermissions=false、directBootAware=false，
    不设置 signature 读权限，鉴权在 call 内逐次执行）；
  - 无障碍服务由 :accessibility 库 Manifest 合入。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 包可见性：只做 LAUNCHER 应用列表与诊断 APK 的明确查询 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.antiads.probe" />
    </queries>

    <application
        android:name=".AntiAdsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiAds"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PackageListActivity"
            android:exported="false"
            android:label="@string/list_title" />

        <activity
            android:name=".ui.PackageDetailActivity"
            android:exported="false"
            android:label="@string/detail_title" />

        <!--
          受控跨进程配置服务（docs/contracts.md 第 6 节）：
          - exported=true（目标应用要读本包最小策略），但只有 call() 的两个只读方法；
          - 鉴权在每次 call 内用 Binder.getCallingUid() 执行，因此不设置会阻断目标读取的 signature 读权限；
          - 不暴露任何写接口：query/getType 返回 null，insert/update/delete/bulkInsert/openFile 一律拒绝。
        -->
        <provider
            android:name=".config.ConfigProvider"
            android:authorities="com.antiads.app.config"
            android:directBootAware="false"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
